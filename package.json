{
  "name": "meta-webhooks-server",
  "version": "1.0.0",
  "private": true,
  "description": "Webhook receiver for Facebook Pages, WhatsApp Business Platform and Instagram (Meta Graph API)",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "smoke": "node scripts/smoke-dashboard.js",
    "test:event": "node --env-file-if-exists=.env scripts/send-test-event.js",
    "subscriptions:list": "node --env-file-if-exists=.env scripts/subscribe.js list",
    "subscribe:pages": "node --env-file-if-exists=.env scripts/subscribe.js pages",
    "subscribe:whatsapp": "node --env-file-if-exists=.env scripts/subscribe.js whatsapp",
    "subscribe:instagram": "node --env-file-if-exists=.env scripts/subscribe.js instagram"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}