# ────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Public base URL used for printing the callback URLs on startup (optional).
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

LOG_LEVEL=info
# Set to true for newline-delimited JSON logs (useful for log collectors)
LOG_JSON=false
# Log the full raw webhook payload (debugging only - it contains user content)
LOG_WEBHOOK_PAYLOADS=false
# Include message text, usernames and media URLs in normalized events (privacy)
INCLUDE_MESSAGE_CONTENT=false

# Access token for the live dashboard (/dashboard). When set, the browser must
# open /dashboard?token=<DASHBOARD_TOKEN>. Leave empty for local testing only.
DASHBOARD_TOKEN=
# How many recent events the dashboard keeps in memory (dashboard history feed)
DASHBOARD_RECENT_LIMIT=200

# ─────────────────────────────────────────────────────────────────────────────
# Meta app credentials
# ─────────────────────────────────────────────────────────────────────────────
# App Dashboard > App settings > Basic > App secret
META_APP_SECRET=
# App Dashboard > App settings > Basic > App ID
META_APP_ID=
# Latest Graph API version at the time of writing (released 2026-07-29)
GRAPH_API_VERSION=v26.0

# Only for local testing without a real signature. NEVER enable in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# Duplicate-delivery suppression window. Meta retries failed deliveries, so the
# same payload can arrive more than once.
WEBHOOK_DEDUPE_TTL_MS=600000

# ─────────────────────────────────────────────────────────────────────────────
# Verify tokens - any string you choose, but it must match the App Dashboard
# ─────────────────────────────────────────────────────────────────────────────
WEBHOOK_VERIFY_TOKEN=change-me-shared-verify-token
# Optional per-product overrides (fall back to WEBHOOK_VERIFY_TOKEN when empty)
PAGES_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Facebook Page subscription  ->  npm run subscribe:pages
# ─────────────────────────────────────────────────────────────────────────────
# Page access token for a person with CREATE_CONTENT / MANAGE / MODERATE task
PAGE_ID=
PAGE_ACCESS_TOKEN=
PAGES_SUBSCRIBED_FIELDS=feed,messages

# ────────────────────────────────────────────────────────────────────────────
# WhatsApp Business Account subscription  ->  npm run subscribe:whatsapp
# ────────────────────────────────────────────────────────────────────────────
WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
# System user access token with whatsapp_business_messaging + whatsapp_business_management
WHATSAPP_SYSTEM_USER_TOKEN=
WHATSAPP_SUBSCRIBED_FIELDS=messages

# ─────────────────────────────────────────────────────────────────────────────
# Instagram subscription  ->  npm run subscribe:instagram
# ────────────────────────────────────────────────────────────────────────────
# instagram = Business Login for Instagram (graph.instagram.com)
# facebook  = Facebook Login for Business / Instagram Messaging via Messenger
INSTAGRAM_LOGIN_MODE=instagram
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SUBSCRIBED_FIELDS=comments,mentions,messages